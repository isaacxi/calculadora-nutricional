{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zg-group.com.mx/schemas/platillos.schema.json",
  "title": "Base de datos de platillos regionales hispanohablantes",
  "type": "object",
  "additionalProperties": false,
  "required": ["version_esquema", "version_datos", "generado_en", "platillos"],
  "properties": {
    "version_esquema": { "type": "string", "const": "1.0.0" },
    "version_datos": { "type": "string" },
    "generado_en": { "type": "string", "format": "date-time" },
    "platillos": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "object" }
    }
  }
}